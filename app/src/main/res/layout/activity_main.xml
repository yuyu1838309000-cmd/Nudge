<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nudge"
            android:textSize="26sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/headerDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/dot_gray"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_dim"
            android:fontFamily="sans-serif"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- 内容区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pageOverview"
            layout="@layout/layout_overview"
            android:visibility="visible" />

        <include
            android:id="@+id/pageTools"
            layout="@layout/layout_tools"
            android:visibility="gone" />

        <include
            android:id="@+id/pageSettings"
            layout="@layout/layout_settings"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部 Tab -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/tabOverview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="概览"
            android:textSize="13sp"
            android:textColor="@color/tab_selected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/tab_bg" />

        <TextView
            android:id="@+id/tabTools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="工具"
            android:textSize="13sp"
            android:textColor="@color/tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/tab_bg" />

        <TextView
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="设置"
            android:textSize="13sp"
            android:textColor="@color/tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/tab_bg" />
    </LinearLayout>
</LinearLayout>
